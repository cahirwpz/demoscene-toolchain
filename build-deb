#!/usr/bin/fakeroot /bin/bash

PREFIX=${PREFIX:-/opt/amiga}
# Releases pass VERSION=YYYY.MM.DD+N; other builds sort before any release.
VERSION=${VERSION:-$(date -u +%Y.%m.%d)~git$(git rev-parse --short HEAD)}

mkdir -p ${PREFIX} || exit 1
source activate
./toolchain-m68k.py build --prefix=${PREFIX} || exit 1
mkdir -p debian/tmp/${PREFIX}
cp -a ${PREFIX}/* debian/tmp/${PREFIX}/
cat > debian/changelog <<EOF
demoscene-toolchain (${VERSION}) unstable; urgency=medium

  * See https://github.com/cahirwpz/demoscene-toolchain/releases

 -- $(sed -n 's/^Maintainer: //p' debian/control)  $(date -R)
EOF
make -f ./debian/rules binary PREFIX=${PREFIX} || exit 1
make -f ./debian/rules clean
