Route the debugger console to stderr and keep it off the GUI.

On non-Windows builds the debugger console funnel (writeconsole_2 /
flushconsole) writes to stderr instead of SDL_Log/stdout: debugger text stays
off the program's stdout stream and escapes SDL_Log's category prefixes, which
would otherwise mangle raw debugger output. The Windows console paths are left
unchanged.

console_logging defaults to 1. While it is set, use_debugger_window() returns
false unconditionally, so the debugger NEVER opens the imgui/macOS window and
always uses the stdin/stderr console path above -- the uaedbg bridge speaks the
console protocol over pipes, which are not TTYs but are still the right target.
console_debugger_available()'s isatty() check (stdin+stderr, the debugger's
actual input/output streams; deliberately NOT stdout, which carries the emulator
log only and is routinely redirected) then governs just one thing: whether
getconsole() puts a real terminal into line/echo mode. It no longer decides
window vs. stdio.

Upstream's redirected-stdio detection (debugger_stdio_redirected()) likewise
checks stdin+stderr instead of stdin+stdout.

Index: demoscene-toolchain/submodules/amiberry/src/osdep/writelog.cpp
===================================================================
--- demoscene-toolchain.orig/submodules/amiberry/src/osdep/writelog.cpp
+++ demoscene-toolchain/submodules/amiberry/src/osdep/writelog.cpp
@@ -52,7 +52,13 @@ static int realconsole;
 static int bootlogmode;
 
 FILE* debugfile = nullptr;
-int console_logging = 0;
+/* Default to console logging so the debugger uses the stderr console path
+ * (see writeconsole_2 below) and never opens the imgui/macOS debugger window.
+ * console_debugger_available() requires this flag; when stdin (debugger input)
+ * and stderr (debugger output) are both TTYs it then suppresses
+ * use_debugger_window(). The gate keys off stdin+stderr, not stdout, because
+ * stdout carries the emulator log only and is routinely redirected. */
+int console_logging = 1;
 // Process-local because console availability depends on how Amiberry was launched.
 static int debugger_type = -1;
 BOOL debuggerinitializing = false;
@@ -97,15 +103,15 @@ static bool debugger_stdin_redirected()
 	return v;
 }
 
-static bool debugger_stdout_redirected()
+static bool debugger_stderr_redirected()
 {
-	static const bool v = fd_is_redirected(STDOUT_FILENO);
+	static const bool v = fd_is_redirected(STDERR_FILENO);
 	return v;
 }
 
 static bool debugger_stdio_redirected()
 {
-	return debugger_stdin_redirected() || debugger_stdout_redirected();
+	return debugger_stdin_redirected() || debugger_stderr_redirected();
 }
 #endif
 
@@ -117,7 +123,7 @@ static bool console_debugger_available()
 #if defined(_WIN32)
 	return true;
 #else
-	return (console_logging && isatty(STDIN_FILENO) && isatty(STDOUT_FILENO))
+	return (console_logging && isatty(STDIN_FILENO) && isatty(STDERR_FILENO))
 		|| debugger_stdio_redirected();
 #endif
 }
@@ -133,6 +139,12 @@ static bool debugger_window_supported()
 
 static bool use_debugger_window()
 {
+	/* This fork drives the debugger over stdio (stdin in, stderr out) so the
+	 * uaedbg bridge can talk to it over pipes. With console logging on we never
+	 * fall back to the imgui/macOS debugger window, even when those streams are
+	 * not TTYs and an SDL video driver is present. */
+	if (console_logging)
+		return false;
 	return debugger_window_supported() && (!console_debugger_available() || debugger_type == 2);
 }
 
