 		if (currprefs.input_tablet > 0) {
-			if (mousehack_alive()) {
-				releasecapture(mon);
-				recapture = 0;
-				return;
-			}
-			SDL_SetCursor(normalcursor);
+			releasecapture(mon);
+			recapture = 0;
+			return;
