+/* Set the visual DMA debugger overlay mode (0..6) from guest code. */
+static uae_u32 emulib_DebugDMA(uae_u32 mode)
+{
+  if (mode > 6)
+    return 0;
+  debug_dma_set_mode(mode);
+  return 1;
+}
