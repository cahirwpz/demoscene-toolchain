Add uaelib trap 42 (DebugDMA) to toggle the visual DMA debugger.

emulib_DebugDMA(mode) sets the debug_dma overlay mode (0..6) from guest code
via the new debug_dma_set_mode() helper, which mirrors the debugger`s own `v`
command (resets the DMA record and drawing state, initialises overlay colours).
Index: demoscene-toolchain/submodules/amiberry/src/debug.cpp
===================================================================
--- demoscene-toolchain.orig/submodules/amiberry/src/debug.cpp
+++ demoscene-toolchain/submodules/amiberry/src/debug.cpp
@@ -1883,6 +1883,25 @@ static void set_debug_colors(void)
 	set_dbg_color(DMARECORD_BLITTER,	6, 0x00, 0xff, 0x00, 0, NULL); // line A-D
 }
 
+/* Set the visual DMA debugger overlay mode (0 disables, 1..6 select a mode)
+ * from outside the debugger console; mirrors the `v` / `v o` console commands
+ * so colours are initialised and the drawing/record state is reset properly. */
+void debug_dma_set_mode(int mode)
+{
+	int ddma = debug_dma;
+	if (debug_dma) {
+		record_dma_reset(0);
+		reset_drawing();
+	}
+	if (mode) {
+		set_debug_colors();
+	}
+	debug_dma = mode;
+	if ((ddma == 2 && debug_dma != 2) || (ddma != 2 && debug_dma == 2)) {
+		reset_drawing();
+	}
+}
+
 static int cycles_toggle;
 
