+/* Write a raw block to the parallel/printer port when it is in TCP mode.
+ * Used to stream Chrome-trace JSON out of the emulator (see uaelib trace). */
+void sendprinter (const char *buf, size_t len)
+{
+	if (parallel_mode == PARALLEL_MODE_TCP_PRINTER) {
+		if (parallel_tcp_connected()) {
+			for (size_t sent = 0; sent < len; ) {
+				int n = uae_socket_write(parallel_tcp, buf + sent, (int)(len - sent));
+				if (n <= 0) {
+					parallel_tcp_disconnect ();
+					return;
+				}
+				sent += n;
+			}
+		}
+	}
+}
