+int logprinter (const char *format, ...)
+{
+  ssize_t sent = 0;
+	if (parallel_mode == PARALLEL_MODE_TCP_PRINTER) {
+		if (parallel_tcp_connected()) {
+      ssize_t len;
+      char *buf;
+      va_list ap;
+      va_start(ap, format);
+      len = vasprintf(&buf, format, ap);
+      va_end(ap);
+      if (len < 0)
+        return -1;
+      while (sent < len) {
+        ssize_t n = uae_socket_write(parallel_tcp, buf + sent, len - sent);
+        if (n <= 0) {
+          parallel_tcp_disconnect ();
+          sent = -1;
+          break;
+        }
+        sent += n;
+      }
+      free(buf);
+    }
+  }
+  return sent;
+}
