@@ -347,6 +348,164 @@ static uae_u32 emulib_DebugDMA(uae_u32 m
   return 1;
 }
 
+static bool trace_event_enabled = false;
+
+#define GETARG() (get_long(m68k_areg(regs, 7) + (1 + (slot++)) * 4))
+
+static void vlog_trace_event(struct trace_event ev, va_list ap, int slot) {
+  static unsigned long cycles_begin = 0;
+  static bool first_call = true;
+
+  if (!trace_event_enabled)
+    return;
+
+  if (first_call) {
+    logprinter("[\n");
+    cycles_begin = get_cycles();
+    first_call = false;
+  }
+
+  unsigned long clock = (currprefs.ntscmode ? CHIPSET_CLOCK_NTSC : CHIPSET_CLOCK_PAL);
+  double ts_us = (double)(get_cycles() - cycles_begin) * 1e6 / (double)(CYCLE_UNIT * clock);
+
+  logprinter("{\"ph\": \"%c\", \"pid\": %d, \"tid\": %d, \"ts\": %.3f", ev.type, ev.pid, ev.tid, ts_us);
+
+  if (ev.type == 'B' || ev.type == 'M' || ev.type == 'C' || ev.type == 'i') {
+    logprinter(", \"name\": \"%s\"", ev.name);
+  }
+  if (ev.type == 'i') {
+    logprinter(", \"s\": \"%c\"", ev.scope);
+  }
+
+  bool empty = true;
+
+  for (;;) {
+    const char *key;
+
+    if (slot) {
+      uae_u32 addr = GETARG();
+      key = addr ? (char *)get_real_address(addr) : NULL;
+    } else {
+      key = va_arg(ap, char *);
+    }
+
+    if (!key)
+      break;
+
+    if (empty) {
+      logprinter(", \"args\": {");
+      empty = false;
+    } else {
+      logprinter(", ");
+    }
+
+    switch (*key++) {
+      case 'S': { /* string */
+        const char *s = slot ? (char *)get_real_address(GETARG()) : va_arg(ap, char *);
+        logprinter("\"%s\": \"%s\"", key, s);
+        break;
+      }
+      case 'I': { /* signed int */
+        int d = slot ? GETARG() : va_arg(ap, int);
+        logprinter("\"%s\": %d", key, d);
+        break;
+      }
+      case 'U': { /* unsigned int */
+        unsigned int d = slot ? GETARG() : va_arg(ap, unsigned int);
+        logprinter("\"%s\": %u", key, d);
+        break;
+      }
+      case 'P': { /* amiga pointer */
+        uae_u32 ptr = slot ? GETARG() : va_arg(ap, uae_u32);
+        logprinter("\"%s\": \"%p\"", key, (void *)ptr);
+        break;
+      }
+    }
+  }
+
+  if (!empty) {
+    logprinter("}");
+  }
+
+  logprinter("},\n");
+}
+
+#undef GETARG
+
+void log_trace_event(struct trace_event ev, ...) {
+  va_list ap;
+  va_start(ap, ev);
+  vlog_trace_event(ev, ap, 0);
+  va_end(ap);
+}
+
+enum {
+  emulib_TraceEventBegin = 43,
+  emulib_TraceEventEnd = 44,
+  emulib_TraceCounter = 45,
+  emulib_TraceInstant = 46,
+  emulib_TraceMetadata = 47,
+};
+
+static uae_u32 emulib_TraceEvent(uae_u32 arg0, uae_u32 arg1, uae_u32 arg2, uae_u32 arg3) {
+  if (!trace_event_enabled) {
+    trace_event_enabled = true;
+
+    log_trace_event((trace_event){.type = 'M', .pid = 0, .tid = 0, .name = "process_name"},
+                    "Sname", "Hardware", NULL);
+    log_trace_event((trace_event){.type = 'M', .pid = 0, .tid = 6, .name = "thread_name"},
+                    "Sname", "Blitter", NULL);
+    log_trace_event((trace_event){.type = 'M', .pid = 0, .tid = 1, .name = "thread_name"},
+                    "Sname", "Disk", NULL);
+  }
+
+  unsigned int hi = (arg1 >> 8) + 1;
+  unsigned int lo = arg1 & 255;
+
+  trace_event ev = {
+    .pid = hi,
+    .tid = hi * 100 + lo,
+    .amiga_addr = true,
+  };
+
+  switch (arg0) {
+    case emulib_TraceEventBegin: {
+      ev.type = 'B';
+      ev.name = (char *)get_real_address(arg2);
+      vlog_trace_event(ev, 0, 3);
+      break;
+    }
+    case emulib_TraceEventEnd: {
+      ev.type = 'E';
+      log_trace_event(ev, 0);
+      break;
+    }
+    case emulib_TraceCounter: {
+      ev.type = 'C';
+      ev.name = (char *)get_real_address(arg2);
+      vlog_trace_event(ev, 0, 3);
+      break;
+    }
+    case emulib_TraceInstant: {
+      ev.type = 'i';
+      ev.name = (char *)get_real_address(arg2);
+      ev.scope = arg3;
+      vlog_trace_event(ev, 0, 4);
+      break;
+    }
+    case emulib_TraceMetadata: {
+      ev.type = 'M';
+      ev.name = (char *)get_real_address(arg2);
+      vlog_trace_event(ev, 0, 3);
+      break;
+    }
+    default:
+      break;
+  }
+
+  return 0;
+}
